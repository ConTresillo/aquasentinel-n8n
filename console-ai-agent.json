    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst isQuery = !!item.query;\nlet event = item.event || {};\nif (!isQuery && !event.event_id) {\n  event = {\n    event_id: item.event_id,\n    event_type: item.event_type,\n    source: item.source,\n    timestamp: item.timestamp,\n    severity: item.severity,\n    node_id: item.node_id,\n    payload: item.payload,\n    status: item.status,\n  };\n}\nconst prompt = isQuery\n  ? `AQUASENTINEL USER QUERY\\n\\nQuestion: ${item.query}\\n\\nUse the available tools to gather evidence from the mock backend, reason over it, and answer the question. End with a clear recommendation if relevant.`\n  : `AQUASENTINEL ANOMALY EVENT TO INVESTIGATE\\n\\nEvent: ${JSON.stringify(event, null, 2)}\\n\\nInvestigate this event using the available tools (current readings, historical readings, anomaly event, sensor status). Reason over the evidence: observation, inference, uncertainty. End your final answer with a \"Recommendation:\" section.`;\nreturn [{\n  json: {\n    prompt,\n    event,\n    event_id: event.event_id || '',\n    isQuery,\n  },\n}];\n"
      },
      "id": "prep-e4626a02c2b1",
      "name": "Prepare Agent Prompt",
