      "id": "manual-dbd6828233a4",
      "name": "Run Scenario (Form)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.4,
      "position": [
        -1200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reads the Form Trigger submission and turns it into event/query items.\nconst f = $input.first().json; // { scenario, node_id, severity, query }\n\n// --- scenario fixtures (do not edit below) ---\nconst SCENARIOS = {\n  salt: {\n    event_type: 'ANOMALY_DETECTED', source: 'TDS_RATE_RULE',\n    payload: { parameter: 'tds', baseline: 320, current: 900 },\n  },\n  silt: {\n    event_type: 'ANOMALY_DETECTED', source: 'TURBIDITY_RATE_RULE',\n    payload: { parameter: 'turbidity', baseline: 1.2, current: 8.9 },\n  },\n  'sensor-spike': {\n    event_type: 'ANOMALY_DETECTED', source: 'SENSOR_SPIKE',\n    payload: { parameter: 'ph', baseline: 7.1, current: 12.4, note: 'impossible value' },\n  },\n  'sensor-offline': {\n    event_type: 'NODE_OFFLINE', source: 'HEARTBEAT',\n    payload: { parameter: 'heartbeat', last_seen_minutes_ago: 18 },\n  },\n  wastewater: {\n    event_type: 'ANOMALY_DETECTED', source: 'MULTI_PARAM_RULE',\n    payload: { parameter: 'multiple', ph: 6.2, tds: 1400, turbidity: 22.5, temperature: 24.1 },\n  },\n  prediction: {\n    event_type: 'PREDICTED_ANOMALY', source: 'TDS_FORECAST_MODEL',\n    payload: { parameter: 'tds', current: 500, predicted_value: 850, prediction_horizon_minutes: 10 },\n  },\n};\n\nconst items = [];\nconst scenario = f.scenario || 'salt';\nif (scenario === 'user_inp') {\n  items.push({ json: { is_query: true, event: null, query: f.query || '' } });\n  return items;\n}\nif (f.query) {\n  items.push({ json: { is_query: true, event: null, query: f.query } });\n  return items;\n}\nconst base = SCENARIOS[scenario];\nif (!base) {\n  return [{ json: { is_query: false, event: null, query: '' } }];\n}\nconst event = {\n  event_id: 'EVT-' + scenario.toUpperCase().replace('-', '') + '-' + String(Date.now()).slice(-4),\n  event_type: base.event_type,\n  source: base.source,\n  timestamp: new Date().toISOString(),\n  severity: f.severity || 'MEDIUM',\n  node_id: f.node_id || 'N01',\n  payload: base.payload,\n};\nitems.push({ json: { is_query: false, event, query: '' } });\nreturn items;\n"
      },
      "id": "ei-68bc5af14e20",
      "name": "Event Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1020,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const PRIORITY = { CRITICAL: 4, HIGH: 3, MEDIUM: 2, LOW: 1 };\nconst items = $input.all().map(i => i.json);\n\nconst work = items.filter(it => it.event || it.query);\nif (work.length === 0) {\n  return [{ json: { noWork: true, message: 'Queue empty — no agent invoked.' } }];\n}\n\nconst entries = work.map((it, i) => ({ it, i, p: it.event ? PRIORITY[it.event.severity] || 0 : 0, isQ: !!it.query }));\nentries.sort((a, b) => {\n  if (a.isQ !== b.isQ) return a.isQ ? 1 : -1;\n  if (b.p !== a.p) return b.p - a.p;\n  return a.i - b.i;\n});\nreturn entries.map(e => ({ json: e.it }));\n"
      },
