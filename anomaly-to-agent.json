{
  "name": "AquaSentinel — Event Investigation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aquasentinel/event",
        "responseMode": "responseNode"
      },
      "id": "01f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-520, 0],
      "webhookId": "aquasentinel-event"
    },
    {
      "parameters": {
        "jsCode": "// Normalize / Validate Event\n// Reject malformed events. No water-quality reasoning here.\nconst required = ['event_id', 'event_type', 'timestamp', 'severity', 'payload'];\nconst supported = ['ANOMALY_DETECTED', 'SENSOR_FAULT', 'NODE_OFFLINE', 'PREDICTED_ANOMALY', 'USER_QUERY'];\nconst output = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  const missing = required.filter(f => body[f] === undefined || body[f] === null || body[f] === '');\n  if (missing.length > 0) {\n    throw new Error(`Malformed event. Missing fields: ${missing.join(', ')}`);\n  }\n  if (!supported.includes(body.event_type)) {\n    throw new Error(`Unsupported event_type: ${body.event_type}`);\n  }\n  output.push({ json: { ...body } });\n}\nreturn output;"
      },
      "id": "02f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b02",
      "name": "Normalize / Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": { "type": "string", "operation": "equals" },
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "ANOMALY_DETECTED"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ANOMALY_DETECTED"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": { "type": "string", "operation": "equals" },
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "SENSOR_FAULT"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "SENSOR_FAULT"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": { "type": "string", "operation": "equals" },
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "NODE_OFFLINE"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "NODE_OFFLINE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": { "type": "string", "operation": "equals" },
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "PREDICTED_ANOMALY"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "PREDICTED_ANOMALY"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": { "type": "string", "operation": "equals" },
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "USER_QUERY"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "USER_QUERY"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Unsupported"
        }
      },
      "id": "03f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b03",
      "name": "Route Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "event_id",
              "type": "string",
              "value": "={{ $json.event_id }}"
            },
            {
              "id": "e2",
              "name": "event_type",
              "type": "string",
              "value": "={{ $json.event_type }}"
            },
            {
              "id": "e3",
              "name": "source",
              "type": "string",
              "value": "={{ $json.source }}"
            },
            {
              "id": "e4",
              "name": "timestamp",
              "type": "string",
              "value": "={{ $json.timestamp }}"
            },
            {
              "id": "e5",
              "name": "severity",
              "type": "string",
              "value": "={{ $json.severity }}"
            },
            {
              "id": "e6",
              "name": "node_id",
              "type": "string",
              "value": "={{ $json.node_id || '' }}"
            },
            {
              "id": "e7",
              "name": "payload",
              "type": "object",
              "value": "={{ $json.payload }}"
            },
            {
              "id": "e8",
              "name": "instruction",
              "type": "string",
              "value": "Investigate this AquaSentinel event using your available tools. Do not monitor continuously."
            }
          ]
        }
      },
      "id": "04f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b04",
      "name": "Prepare Agent Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_API_URL || 'http://host.docker.internal:8000/agent/investigate' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\n  \"event\": {\n    \"event_id\": \"{{ $json.event_id }}\",\n    \"event_type\": \"{{ $json.event_type }}\",\n    \"source\": \"{{ $json.source }}\",\n    \"timestamp\": \"{{ $json.timestamp }}\",\n    \"severity\": \"{{ $json.severity }}\",\n    \"node_id\": \"{{ $json.node_id }}\",\n    \"payload\": {{ JSON.stringify($json.payload) }}\n  },\n  \"instruction\": \"{{ $json.instruction }}\"\n}",
        "options": {}
      },
      "id": "05f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b05",
      "name": "Call Real Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [120, 0]
    },
    {
      "parameters": {
        "jsCode": "// Parse the real agent's structured result.\n// Agent response may be nested under body when Return Full Response is used.\nconst item = $input.first().json;\nconst data = item.body && typeof item.body === 'object' ? item.body : item;\nconst eventId = data.event_id || item.event_id || '';\nreturn [{\n  json: {\n    event_id: eventId,\n    status: data.status || 'INVESTIGATED',\n    investigation_result: data.investigation_result || '',\n    confidence: data.confidence ?? null,\n    recommendation: data.recommendation || ''\n  }\n}];"
      },
      "id": "06f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b06",
      "name": "Parse Agent Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.BACKEND_API_URL || 'http://host.docker.internal:8000' }}/api/events/{{ $json.event_id }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\n  \"event_id\": \"{{ $json.event_id }}\",\n  \"status\": \"{{ $json.status }}\",\n  \"investigation_result\": \"{{ $json.investigation_result }}\",\n  \"confidence\": {{ $json.confidence }},\n  \"recommendation\": \"{{ $json.recommendation }}\"\n}",
        "options": {}
      },
      "id": "07f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b07",
      "name": "Update Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"event_id\": \"{{ $json.event_id }}\",\n  \"status\": \"{{ $json.status }}\",\n  \"agent_result\": \"{{ $json.investigation_result }}\"\n}",
        "options": {}
      },
      "id": "08f4d8f0-5c5d-4c0e-8f3f-3a2f9a1d1b08",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 2,
      "position": [600, 0]
    }
  ],
  "connections": {
